# ============================================================================
# REQUIRED: MySQL Database Connection
# ============================================================================
# Local development example:
# DATABASE_URL="mysql://root:root@localhost:3306/zws_cloud"
#
# Production example (AWS RDS):
# DATABASE_URL="mysql://admin:password@rds-instance.us-east-1.rds.amazonaws.com:3306/zws_cloud"
#
# Production example (DigitalOcean):
# DATABASE_URL="mysql://doadmin:password@db-instance.db.ondigitalocean.com:3306/zws_cloud?sslmode=REQUIRED"
DATABASE_URL="mysql://root:root@localhost:3306/zws_cloud"

# ============================================================================
# REQUIRED: Admin Authentication
# ============================================================================
# Email used to log in to the admin dashboard
ADMIN_EMAIL="admin@zws.cloud"

# Strong password for initial admin account
ADMIN_PASSWORD="ChangeMe@123"

# Display name for admin user
ADMIN_DISPLAY_NAME="Administrator"

# JWT Secret for signing admin session tokens (REQUIRED, min 32 chars for production)
# Generate with: openssl rand -hex 32
JWT_SECRET="dev-key-change-this-in-production-needs-32-chars-minimum"

# ============================================================================
# REQUIRED: Cashfree Payment Gateway (Payments feature)
# ============================================================================
# Get these from: https://dashboard.cashfree.com/
CASHFREE_APP_ID="your-cashfree-app-id-here"
CASHFREE_SECRET_KEY="your-cashfree-secret-key-here"
CASHFREE_MODE="test"
CASHFREE_WEBHOOK_SECRET="your-cashfree-webhook-secret"

# ============================================================================
# OPTIONAL: Redis Cache & Session Store (improves performance)
# ============================================================================
# If not set, app works without caching (graceful degradation)
# Local: REDIS_URL="redis://localhost:6379"
# Cloud: REDIS_URL="rediss://default:password@redis-host:6379"
# REDIS_URL="redis://localhost:6379"

# ============================================================================
# Application Configuration
# ============================================================================
# Public-facing URL for your application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# ============================================================================
# OPTIONAL: Email Configuration (for invoices, password resets)
# ============================================================================
# If not set, email features are disabled
MAIL_FROM="noreply@zws.cloud"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ============================================================================
# Business Configuration
# ============================================================================
COMPANY_NAME="ZWS Cloud"
COMPANY_EMAIL="support@zws.cloud"
COMPANY_PHONE="+91 80 1234 5678"
COMPANY_ADDRESS="123 Tech Park, Bangalore, Karnataka 560001"
# COMPANY_GST_IN="29XXXXX1234X1ZX"

# ============================================================================
# Pricing Configuration
# ============================================================================
DEFAULT_CURRENCY="INR"
DEFAULT_TAX_RATE="18"

# Discount percentages for term-based billing
DISCOUNT_3M="10"
DISCOUNT_6M="15"
DISCOUNT_12M="20"
DISCOUNT_24M="25"

# ============================================================================
# Feature Limits
# ============================================================================
MAX_CUSTOM_RAM_GB="256"
MAX_CUSTOM_CPU="64"
MAX_CUSTOM_STORAGE_GB="4000"

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL="info"
ENABLE_DETAILED_LOGS="false"

# ============================================================================
# Security Configuration
# ============================================================================
SESSION_TIMEOUT_MINUTES="1440"
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"
